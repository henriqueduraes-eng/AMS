programa {
  funcao inicio() {
    inteiro quantidade_minima, quantidade_maxima
    real estoque_medio

    escreva("DIGITE A QUANTIDADE MÍNIMA ")
  leia(quantidade_minima)

    escreva("DEGITE A QUANTIDADE MÁXIMA ")
    leia(quantidade_maxima)

    estoque_medio =(quantidade_minima + quantidade_maxima) / 2

    escreva("O ESTOQUE MÉDIO É: ", estoque_medio)
  }
}
