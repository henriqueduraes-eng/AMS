programa
{
    funcao inicio()
    {
        cadeia palavras[] = {"Questão", "Fundamental"}

        escreva("Antes da alteração: ", palavras[0], "\n")

        palavras[0] = "Pergunta"

        escreva("Depois da alteração: ", palavras[0], "\n")

        escreva("Segunda palavra: ", palavras[1])
    }
}